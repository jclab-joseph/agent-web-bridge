{
  "name": "@agent-web-bridge/vue",
  "version": "0.1.0",
  "description": "Vue components for agent-web-bridge sessions",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": "./dist/style.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@agent-web-bridge/protocol": "workspace:*",
    "markdown-it": "^15.0.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
