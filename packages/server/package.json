{
  "name": "@agent-web-bridge/server",
  "version": "0.1.0",
  "description": "Spawn and manage AI agent sessions and bridge them to web clients",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./claude-code": "./src/providers/claude-code.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./claude-code": {
        "types": "./dist/claude-code.d.mts",
        "import": "./dist/claude-code.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@agent-web-bridge/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@anthropic-ai/claude-agent-sdk": "0.3.309"
  }
}
